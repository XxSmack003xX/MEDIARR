{
  "name": "MEDIARR 2.0",
  "short_name": "MEDIARR",
  "description": "Unified self-hosted media intelligence, automation, requests, playback and download dashboard.",
  "id": "/",
  "start_url": "/?pwa=1&v2=overview",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0c0b0e",
  "theme_color": "#0c0b0e",
  "orientation": "any",
  "icons": [
    {
      "src": "/icons/mediarr-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/mediarr-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/mediarr-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Media Intelligence",
      "short_name": "Intelligence",
      "url": "/?pwa=1&v2=library",
      "icons": [
        {
          "src": "/icons/mediarr-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Universal Search",
      "short_name": "Search",
      "url": "/?pwa=1&v2=search",
      "icons": [
        {
          "src": "/icons/mediarr-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Download Pipeline",
      "short_name": "Downloads",
      "url": "/?pwa=1&v2=pipeline",
      "icons": [
        {
          "src": "/icons/mediarr-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Notifications",
      "short_name": "Notifications",
      "url": "/?pwa=1&v2=notifications",
      "icons": [
        {
          "src": "/icons/mediarr-icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
